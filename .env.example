NODE_ENV=development

PORT=3000

CLIENT_PORT=4200

CORS_ORIGIN=http://localhost:4200

DATABASE_URL="postgresql://postgres:password@localhost:5432/cinematch_db?schema=public"

SHADOW_DATABASE_URL="postgresql://postgres:password@localhost:5432/cinematch_shadow?schema=public"

JWT_SECRET=your_very_long_and_random_jwt_secret_key_here

JWT_EXPIRES_IN=7d

JWT_REFRESH_SECRET=your_very_long_and_random_jwt_refresh_secret_key_here

JWT_REFRESH_EXPIRES_IN=30d

TMDB_ACCESS_TOKEN=your_tmdb_api_read_access_token_here

TMDB_BASE_URL=https://api.themoviedb.org/3

TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p

TMDB_POSTER_SIZE=w500

TMDB_BACKDROP_SIZE=w1280

TMDB_LANGUAGE=uk-UA

TMDB_REGION=UA

GOOGLE_AI_API_KEY=your_google_ai_studio_api_key_here

GOOGLE_AI_MODEL=gemini-1.5-flash

GOOGLE_AI_TIMEOUT_MS=10000

OPENROUTER_API_KEY=your_openrouter_api_key_here

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

OPENROUTER_MODEL=mistralai/mistral-7b-instruct

OPENROUTER_TIMEOUT_MS=10000

AI_PRIMARY_PROVIDER=google

AI_ENABLE_FALLBACK=true

SYNC_ENABLED=true

SYNC_POPULAR_CRON=0 */6 * * *

SYNC_NOW_PLAYING_CRON=0 */12 * * *

SYNC_GENRES_CRON=0 0 * * *

SYNC_POPULAR_PAGES=5

SYNC_NOW_PLAYING_PAGES=3

ADMIN_EMAIL=admin@cinematch.local

ADMIN_PASSWORD=change_me_in_production

API_BASE_URL=http://localhost:3000

DEFAULT_LANGUAGE=uk

